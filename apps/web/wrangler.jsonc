{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mplus-lfg-web",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "keep_vars": true
}
