/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mplus-lfg",
	"main": "src/index.ts",
  "compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * D1 (SQLite) — schema lives in ./schema.sql
	 * Create with: pnpm exec wrangler d1 create mplus-lfg
	 * Then paste the returned database_id below.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mplus-lfg",
			"database_id": "7dabf0b4-eef8-4fdb-8423-97c997d37c47"
		}
	],
	/**
	 * Cron sweep: expires runs past their start time and closes out their messages.
	 * https://developers.cloudflare.com/workers/configuration/cron-triggers/
	 */
	"triggers": {
		"crons": [
			"*/10 * * * *"
		]
	}
	/**
	 * Secrets (never put these in this file):
	 *   pnpm exec wrangler secret put DISCORD_PUBLIC_KEY
	 *   pnpm exec wrangler secret put DISCORD_APPLICATION_ID
	 *   pnpm exec wrangler secret put DISCORD_TOKEN
	 * For local dev, put the same keys in .dev.vars (see .dev.vars.example).
	 */
}
