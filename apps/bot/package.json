{
	"name": "@mplus-lfg/bot",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"cf-typegen": "wrangler types",
		"register": "node scripts/register-commands.ts",
		"db:init": "wrangler d1 execute mplus-lfg --local --file=./schema.sql",
		"db:init:remote": "wrangler d1 execute mplus-lfg --remote --file=./schema.sql",
		"db:migrate": "wrangler d1 migrations apply mplus-lfg --local",
		"db:migrate:remote": "wrangler d1 migrations apply mplus-lfg --remote"
	},
	"dependencies": {
		"discord-api-types": "^0.38.53"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.4",
		"@types/node": "^26.2.0",
		"typescript": "^5.5.2",
		"vitest": "~3.2.0",
		"wrangler": "^4.123.0"
	}
}
