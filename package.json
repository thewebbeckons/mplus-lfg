{
  "name": "mplus-lfg",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @mplus-lfg/web dev",
    "dev:web": "pnpm --filter @mplus-lfg/web dev",
    "dev:bot": "pnpm --filter @mplus-lfg/bot dev",
    "build": "pnpm --filter @mplus-lfg/web build",
    "build:web": "pnpm --filter @mplus-lfg/web build",
    "deploy:bot": "pnpm --filter @mplus-lfg/bot deploy",
    "test": "pnpm --filter @mplus-lfg/bot test",
    "typecheck": "pnpm -r typecheck",
    "register": "pnpm --filter @mplus-lfg/bot register",
    "cf-typegen": "pnpm --filter @mplus-lfg/bot cf-typegen"
  }
}
